# Copy to .env and fill in. MONGO_URI is the only value required for the app
# to actually connect to a database — every route still registers and
# /actions/health works with nothing set.
ENV=dev
MONGO_URI=
MONGO_DB_NAME=ledger
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
DEBUG=false
