<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- LED-7 SMS pipeline (plan.md §2.1, §7, §13): sideload/Internal-Testing
         distribution only, never a public Play Store listing while this is
         declared, per the non-negotiable constraint in CLAUDE.md. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- LED-31: backs SmsReconciliationWorker's periodic re-scan of the
         device SMS inbox — a safety net that catches any silently-dropped
         SMS the real-time SmsReceiver path missed (dead token, OS/OEM
         background kill, transient network fault, etc). Still filtered
         through SmsAllowlist before anything leaves the device — this only
         widens *when* allow-listed messages get checked, not *which* ones
         are eligible to be forwarded. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- LED-15: Android 13+ requires this as a runtime-requested permission
         before FCM notifications can be shown; requested via
         PermissionsAndroid at the point registerForPushNotifications() runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- LED-31: lets SmsReliabilityModule prompt the user to exempt Ledger
         from Doze/App Standby battery optimization — otherwise the OS can
         indefinitely defer the WorkManager network job that actually
         forwards an already-received SMS. Normal permission, no runtime
         prompt of its own; only launching the system dialog needs consent. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <!-- Manifest-registered (not JS/dynamically registered) so it keeps
           receiving broadcasts even when the app is backgrounded or killed
           (plan.md §13). android:exported must be true for a system
           broadcast; android:permission restricts delivery to senders
           holding BROADCAST_SMS (the platform/telephony stack only). -->
      <receiver
        android:name=".sms.SmsReceiver"
        android:exported="true"
        android:permission="android.permission.BROADCAST_SMS">
        <intent-filter>
          <action android:name="android.provider.Telephony.SMS_RECEIVED" />
        </intent-filter>
      </receiver>
      <!-- LED-15: tints the small notification icon with the design system's
           indigo accent (DESIGN_BRIEF.md) instead of Android's default gray,
           for pushes sent without an explicit color (shared/fcm.py doesn't
           set one). -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/notification_accent"
        tools:replace="android:resource" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
